# ===== Python =====
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# ===== 运行时生成物（不备份，可再生成） =====
# 训练/预测/异常记录 + ML 模型（约 585MB，含 pkl 模型）
training/
# 统计缓存
cache/
# 日志（logs/logger.py 是运行时依赖的源码模块，必须入库；其余日志产物忽略）
logs/*
!logs/logger.py
# 异步任务数据库
tasks.db
# pytest 临时目录（沙箱下需显式指定，避免 safe-delete 清理崩溃）
.pytest_tmp/

# ===== 操作系统 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== IDE =====
.idea/
.vscode/
*.swp

# ===== WorkBuddy =====
.workbuddy/
.reasonix/
# 含密钥的本地工具配置（api_key / Authorization），不进版本控制
reasonix.toml

# ===== 运行时锁文件 =====
*.csv.lock

# ===== 数据备份（替换前的旧 CSV，本地留档不入库） =====
*.bak
*.bak_*

# ===== 一次性运维脚本（探测/临时推送/数据探针，用完即弃，不入库） =====
# scripts/ 根目录的 `_*.py` 一律拦：根目录只放长期运维脚本（export_pdf /
# rebuild_market_closure / sync_* / prune_logs 等），别再堆临时文件。
# 2026-10-21 已把 43 个历史 `_*.py` 移入 scripts/oneoff/（那几个仍在版本里，
# 因为要保留当时怎么验的痕迹）；一次性脚本以后直接写进 oneoff/，
# 下面这条规则保证它们不会意外入库。
scripts/_*.py
scripts/oneoff/_*.py

# ===== 文档/工具中间产物（docx 改写临时文件、探针输出） =====
*.tmp
*.docx.tmp
.wprobe_*

# ===== 历史开奖数据（约 3.3MB CSV，纳入版本做备份；锁文件与替换前的旧档忽略） =====
lottery_data/_backup_*/

# ===== 临时/缓存目录（PPT 工具与 pytest 产物，不入库） =====
.pytest_cache/
.cache/
.slidep/
docs/_backup/
~$*

# ===== 求职材料（个人用途，绝不入库/公开；2026-09-18 起显式屏蔽） =====
docs/求职一页纸.*
docs/求职项目简介/
docs/_backup/求职*
求职*

# ===== 运行时状态（看门狗/调度器/worker 状态、重启标志，不入库） =====
# 必须是 config/* 而不是 config/：目录被整体忽略后，Git **不允许**再用 `!`
# 放行其中的文件（忽略目录会短路其下所有规则），那样 ticket_size.json 永远进不来。
# 放行 ticket_size.json 的理由：它存的是用户亲手设的「每次出号几注」
# （2026-10 为 双色球 200 / 大乐透 38 / 排列3 50 / 七星彩 44），
# 属于**业务配置**而非运行时状态 —— 丢了无法重建，换机/回滚就还原不出同一套出号量。
# push_notify.json 含企业微信 webhook token，必须继续排除。
config/*
!config/ticket_size.json
# 低拥挤策略的情景参数（三档 λ / 门控 / 生产默认档）—— 策略配置，不是运行时状态，也不含密钥
!config/lowcrowd.json
# 盈利策略的政策与情景配置（税率/κ 网格/情景倍数/台账开关），不是运行时状态也不是密钥
!config/profit.json
# 联合实验的预注册（期窗/常量/主终点/家族/停止规则 + 自校验哈希）—— 实验契约，必须入库
!config/preregistration.json
# 月度总投入硬上限（谁的额度、多少、是否启用）—— **业务政策**，与 ticket_size.json 同级：
# 丢了就还原不出同一套预算约束。注意 `budget_spend.json`（实际记账台账）故意**不**放行，
# 它是运行时状态，跨机器/回滚都不该跟着搬。
!config/budget_aggregate.json
# 审计阈值（异常判据 + 锁定标记 + 设定日期）—— 与预注册同类：**判据必须先定后锁**。
# 不入库的话，「阈值什么时候被改过」就无从追查，而改阈值正是最容易的事后合理化手段。
!config/audit_thresholds.json
logs/flask_stdout.log
logs/run_supervisor.log

# ===== 一次性输出/测试落盘（pytest 全量日志、临时重定向文件，不入库） =====
.pytest_tmp_glob.log
.pytest_tmp_run.log
.pytest_tmp_run2.log
logs/_pytest_*.log
# 仓库根目录散落的手动重定向日志（.pytest_full.log / .dry1.log / .preview*.log 等，
# 2026-10-26 清理 38 个历史遗留时补此规则；logs/ 目录内仍只放行 logger.py）
/*.log

# ===== 本地 git 修复遗留（2026-10-08 重建仓库前的空壳 .git 备份，不入库） =====
.git.broken-*/

# ===== 兜底推送/复核的一次性脚本（代理 502 时走 REST API 用，不入库） =====
.api_push*.py
.api_verify*.py

# ===== 研究用一次性网格/诊断脚本与日志（跑完即删，不入库） =====
# 命名约定：点前缀 + .grid_/.log_/.scratch_，只存在于仓库根目录。
.grid_*.py
.grid_*.json
.log_*.txt
.scratch_*.py

# market.db 旁路补充库（可随时删除重建，不入库）
market/*.db
market/*.db-wal
market/*.db-shm
market/cache.db-journal
# 更新编排的互斥锁（运行时产物，残留会被当成本地状态误提交）
market/.update.lock
# 财政部月报附件缓存（2008 起约 330 个文件 / 11MB，可随时重新下载）
market/.mof_cache/

# ===== output/ 下的运行日志（跑数重定向产物，不入库；output/ 里的结论性 md/json 仍入库） =====
output/*.log
output/*.txt

# 真实浏览器验证脚本的 Chrome 临时 profile（每次跑都重建）
.cdp_profile*/
# 账本 / 影子 / 留证：运行时数据，随训练产物一起忽略
training/ledger/
training/shadow/
training/attest/
# 推送前的运行时文件备份目录（用完即删；万一推送脚本的重置吞掉改动，靠它还原）
.pre_push_backup/
